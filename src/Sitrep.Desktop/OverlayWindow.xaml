<Window x:Class="Sitrep.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SitrepOverlay" Width="320" Height="120" Topmost="True"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" ShowActivated="False"
        Background="#80000000" Foreground="White">
    <Border BorderBrush="#80FFFFFF" BorderThickness="1" Margin="4">
        <TextBlock x:Name="OverlayText" Margin="10" FontSize="14" Text="SET MORTAR WITH F8" TextWrapping="Wrap" IsHitTestVisible="False" />
    </Border>
</Window>
