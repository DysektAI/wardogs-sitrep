<Window x:Class="Sitrep.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SitrepOverlay" Width="420" SizeToContent="Height" MinHeight="120" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" ShowActivated="False"
        Background="Transparent" Foreground="White" IsHitTestVisible="False">
    <Border x:Name="OverlayCard" Margin="4" CornerRadius="8"
            Background="#8014181F" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Grid>
            <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    CornerRadius="2,0,0,2" Background="#FF4C8DFF" Margin="0,10"/>
            <TextBlock x:Name="OverlayText" Margin="16,12,12,12" FontSize="14" FontFamily="Segoe UI"
                       Text="SET MORTAR WITH F8" TextWrapping="Wrap" IsHitTestVisible="False" Foreground="#FFF2F5F9"/>
        </Grid>
    </Border>
</Window>
