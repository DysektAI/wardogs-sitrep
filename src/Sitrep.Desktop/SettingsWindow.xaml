<Window x:Class="Sitrep.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SITREP Settings" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Applied on Save and written to %LocalAppData%\Sitrep\config.json"
                       Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="GAME WINDOW" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Text="Window title contains" Margin="0,10,0,4" FontSize="12"/>
                <TextBox x:Name="TitleContainsBox"/>
                <TextBlock Text="Live capture only runs while the foreground window title contains this text. Empty keeps capture disabled."
                           Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <CheckBox x:Name="DesktopTestBox" Content="Desktop test mode — allow any foreground window"
                          Margin="0,12,0,0" Checked="DesktopTestBox_Changed" Unchecked="DesktopTestBox_Changed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="CAPTURE REGION" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Text="Rectangle around the cursor where the map coordinate labels are read."
                           Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Width" Style="{StaticResource CaptionStyle}"/>
                        <TextBox x:Name="RoiWidthBox" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Height" Style="{StaticResource CaptionStyle}"/>
                        <TextBox x:Name="RoiHeightBox" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Offset X" Style="{StaticResource CaptionStyle}"/>
                        <TextBox x:Name="RoiOffsetXBox" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Offset top" Style="{StaticResource CaptionStyle}"/>
                        <TextBox x:Name="RoiOffsetTopBox" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="OVERLAY AND DIAGNOSTICS" Style="{StaticResource SectionHeaderStyle}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Overlay position" FontSize="12"/>
                        <TextBlock x:Name="OverlayPosText" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" Text="Default (top-right)"/>
                    </StackPanel>
                    <Button x:Name="ResetOverlayButton" Grid.Column="1" Content="Reset to default"
                            VerticalAlignment="Center" Click="ResetOverlayButton_Click"/>
                </Grid>
                <CheckBox x:Name="DebugModeBox" Content="Save debug captures (keeps last 50 images)" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationText" Grid.Row="4" Margin="0,12,0,0" FontSize="12"
                   Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="96" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="Save" Width="96" Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
