<Window x:Class="Sitrep.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SITREP — Mortar Assistant" Width="480" Height="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: identity + live state pill -->
        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SITREP" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="WARDOGS Mortar Assistant" Style="{StaticResource CaptionStyle}"/>
            </StackPanel>
            <Border x:Name="LivePill" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="12" Padding="10,5" BorderThickness="1"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="LiveDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource DisabledBrush}"/>
                    <TextBlock x:Name="LivePillText" Margin="7,0,0,0" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Text="LIVE OFF"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Startup warning (hidden when everything loaded) -->
        <Border x:Name="StartupBanner" Grid.Row="1" Margin="0,14,0,0" CornerRadius="6" Padding="10,8"
                Background="{StaticResource BannerBgBrush}" BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="13" VerticalAlignment="Top"
                           Foreground="{StaticResource WarningBrush}"/>
                <TextBlock x:Name="StartupBannerText" Margin="8,0,0,0" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Firing solution card -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0" VerticalAlignment="Top">
            <StackPanel>
                <Grid>
                    <TextBlock Text="FIRING SOLUTION" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock x:Name="WeaponText" HorizontalAlignment="Right" FontSize="11"
                               Foreground="{StaticResource TextDimBrush}" Text="L81 · table-backed"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{StaticResource InfoBrush}"/>
                    <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                               Text="SET MORTAR WITH F8" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ElevationValue" FontFamily="Consolas" FontSize="40"
                                   FontWeight="Bold" Text="—" VerticalAlignment="Bottom"/>
                        <TextBlock Margin="8,0,0,8" FontSize="14" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextDimBrush}" Text="MIL"/>
                    </StackPanel>
                    <TextBlock Text="ELEVATION (UNCORRECTED TABLE)" Style="{StaticResource SectionHeaderStyle}" Margin="0,2,0,0"/>
                </StackPanel>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RANGE" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock x:Name="RangeValue" FontFamily="Consolas" FontSize="20" Margin="0,2,0,0" Text="—"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="BEARING" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock x:Name="BearingValue" FontFamily="Consolas" FontSize="20" Margin="0,2,0,0" Text="—"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Margin="0,16,0,0" Background="{StaticResource CardBorderBrush}"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ORIGIN (F8)" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock x:Name="OriginValue" Style="{StaticResource MonoValueStyle}" Margin="0,2,0,0" Text="—"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TARGET (F7 / MMB)" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock x:Name="TargetValue" Style="{StaticResource MonoValueStyle}" Margin="0,2,0,0" Text="—"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="EnableButton" Grid.Column="0" Content="Enable live"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5,0" Click="EnableButton_Click"/>
            <Button x:Name="ClearButton" Grid.Column="1" Content="Clear"
                    Margin="5,0,5,0" Click="ClearButton_Click"/>
            <Button x:Name="SettingsButton" Grid.Column="2" Content="Settings"
                    Margin="5,0,5,0" Click="SettingsButton_Click"/>
            <Button x:Name="ExitButton" Grid.Column="3" Content="Exit"
                    Style="{StaticResource DangerButtonStyle}" Margin="5,0,0,0" Click="ExitButton_Click"/>
        </Grid>

        <!-- Footer hints -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                       Text="F8 set origin  ·  F7 / middle-click set target  ·  F9 clear  ·  F10 disable live. Hotkeys work while live capture is on; use Enable live to start."/>
            <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="The overlay is click-through; closing this window exits the app."/>
        </StackPanel>
    </Grid>
</Window>
