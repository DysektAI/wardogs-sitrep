<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- No PackageReferences: opt out of lock file. Otherwise publish with
         a runtime identifier rewrites packages.lock.json with a win-x64 graph
         and breaks the next locked mode restore. Desktop/Tests keep locks. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
